{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SpecificCrossAccountPrincipalGetObject",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::400000000001:role/alpha-role"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::bucket-bpa-specific-principal-bucket/*"
    }
  ]
}
